# Required to run `npm run build:lib` (inlined into the published package).
# Do not commit the real key.
MUI_X_LICENSE_KEY=

# Optional. Used to link AB# story ids in generated changelogs.
# If unset, `npm run release` infers org/project from `git remote origin` when it is Azure DevOps.
# AZURE_DEVOPS_ORG=
# AZURE_DEVOPS_PROJECT=
# AZURE_DEVOPS_STORY_URL=https://dev.azure.com/{organization}/{project}/_workitems/edit/{id}
