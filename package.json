      "types": "./dist/exports/x-charts-premium.d.ts",
      "import": "./dist/exports/x-charts-premium.js"
    },
    "./x-tree-view": {
      "types": "./dist/exports/x-tree-view.d.ts",
      "import": "./dist/exports/x-tree-view.js"
    },
    "./x-tree-view-pro": {
      "types": "./dist/exports/x-tree-view-pro.d.ts",
      "import": "./dist/exports/x-tree-view-pro.js"
    },
    "./x-scheduler": {
      "types": "./dist/exports/x-scheduler.d.ts",
      "import": "./dist/exports/x-scheduler.js"
    },
    "./x-scheduler-premium": {
      "types": "./dist/exports/x-scheduler-premium.d.ts",
      "import": "./dist/exports/x-scheduler-premium.js"
    },
    "./x-license": {
      "types": "./dist/exports/x-license.d.ts",
      "import": "./dist/exports/x-license.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.10",
