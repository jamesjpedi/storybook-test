{
  "name": "bhhc-design-system",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "BHHC design system — MUI Material, Core, and X replacement with license signing included.",
  "main": "./dist/exports/material.js",
  "module": "./dist/exports/material.js",
  "types": "./dist/exports/material.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/**/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/exports/material.d.ts",
      "import": "./dist/exports/material.js"
    },
    "./material": {
      "types": "./dist/exports/material.d.ts",
      "import": "./dist/exports/material.js"
    },
    "./icons-material": {
      "types": "./dist/exports/icons-material.d.ts",
      "import": "./dist/exports/icons-material.js"
    },
    "./system": {
      "types": "./dist/exports/system.d.ts",
      "import": "./dist/exports/system.js"
    },
    "./utils": {
      "types": "./dist/exports/utils.d.ts",
      "import": "./dist/exports/utils.js"
    },
    "./lab": {
      "types": "./dist/exports/lab.d.ts",
      "import": "./dist/exports/lab.js"
    },
    "./styled-engine": {
      "types": "./dist/exports/styled-engine.d.ts",
      "import": "./dist/exports/styled-engine.js"
    },
