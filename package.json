      "types": "./dist/exports/x-data-grid-premium.d.ts",
      "import": "./dist/exports/x-data-grid-premium.js"
    },
    "./x-date-pickers": {
      "types": "./dist/exports/x-date-pickers.d.ts",
      "import": "./dist/exports/x-date-pickers.js"
    },
    "./x-date-pickers-pro": {
      "types": "./dist/exports/x-date-pickers-pro.d.ts",
      "import": "./dist/exports/x-date-pickers-pro.js"
