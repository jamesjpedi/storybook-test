# One-time baseline tags. Run manually from the pipeline UI.
# Tags each branch tip in place. qa and dev are not merged, because those
# histories conflict. semantic-release reads the tag on the branch it releases:
#   main -> vX.Y.Z
#   qa   -> vX.Y.Z-qa.0
#   dev  -> vX.Y.Z-dev.0
trigger: none
pr: none

parameters:
  - name: version
    displayName: "Baseline version. Leave empty to read package.json on main."
    type: string
    default: "0.6.0"

name: baseline-tag-$(Date:yyMMdd)$(Rev:.rrr)

variables:
  - name: ReactProjectName
    value: BHHC.Design.Components.React

jobs:
  - job: BaselineTag
    displayName: "Tag main, qa, and dev in place"
    pool:
      vmImage: windows-latest
    steps:
      - checkout: self
        fetchDepth: 0
        persistCredentials: true
        clean: true

      - pwsh: |
          $ErrorActionPreference = "Stop"
          function Invoke-Git {
            & git @args
            if ($LASTEXITCODE -ne 0) { throw "git $($args -join ' ') failed with exit $LASTEXITCODE" }
          }

          Invoke-Git config user.email "azure-pipelines@local"
          Invoke-Git config user.name "Azure Pipelines"
          Invoke-Git fetch origin main qa dev --tags --force

          $requested = "${{ parameters.version }}".Trim()
          if ($requested -notmatch "^\d+\.\d+\.\d+$") { throw "Version '$requested' must be X.Y.Z with no prerelease suffix." }

          $tags = @(
            @{ Branch = "main"; Tag = "v$requested" },
            @{ Branch = "qa"; Tag = "v$requested-qa.0" },
            @{ Branch = "dev"; Tag = "v$requested-dev.0" }
          )

          foreach ($item in $tags) {
            $branch = $item.Branch
            $tag = $item.Tag
            Invoke-Git checkout -B $branch "origin/$branch"
            $head = (Invoke-Git rev-parse HEAD).Trim()
            $packagePath = "src/$(ReactProjectName)/package.json"
            $packageVersion = (Get-Content -Raw $packagePath | ConvertFrom-Json).version
            Write-Host "$branch HEAD $head package.json version $packageVersion, tag $tag"

            $existing = git rev-parse -q --verify "refs/tags/$tag"
            if ($LASTEXITCODE -eq 0) {
              $taggedCommit = (Invoke-Git rev-parse "${tag}^{}").Trim()
              if ($taggedCommit -ne $head) {
                throw "Tag $tag already points at $taggedCommit, not $branch HEAD $head."
              }
              Write-Host "Tag $tag already points at $branch HEAD."
            } else {
              Invoke-Git tag -a $tag $head -m "chore: baseline $tag"
              Write-Host "Created $tag on $branch $head."
            }
          }

          Invoke-Git push origin refs/tags/v$requested refs/tags/v$requested-qa.0 refs/tags/v$requested-dev.0
          Write-Host "Pushed v$requested, v$requested-qa.0, and v$requested-dev.0. No branches were merged."
        displayName: "Tag main, qa, and dev"
